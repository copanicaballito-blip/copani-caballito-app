// Reglas de Firestore. Se publican a mano: Firebase > Firestore Database > Reglas > pegar > Publicar.
//
// IMPORTANTE: este repositorio es público. Acá van emails de ejemplo; en la consola de Firebase hay
// que reemplazarlos por los emails reales del equipo (en minúsculas). No subir los reales al repo.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function autorizado() {
      return request.auth != null
        && request.auth.token.email in [
          "persona1@ejemplo.com",
          "persona2@ejemplo.com",
          "persona3@ejemplo.com"
        ];
    }

    // formaPago y rubro son opcionales. El rubro solo se valida como texto corto (la lista de rubros
    // vive en la app), así agregar un rubro nuevo no obliga a republicar las reglas.
    function gastoValido(g) {
      return g.keys().hasOnly(["descripcion", "monto", "fechaPago", "estado", "pagos", "formaPago", "rubro"])
        && g.get("rubro", "") is string && g.get("rubro", "").size() <= 40
        && g.descripcion is string && g.descripcion.size() > 0 && g.descripcion.size() <= 120
        && g.monto is int && g.monto >= 0
        && g.fechaPago is string && g.fechaPago.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
        && g.estado in ["estimado", "a_pagar", "pagado"]
        && g.get("formaPago", "sin_definir") in ["sin_definir", "manual_mp", "debito_mp", "manual_galicia", "debito_galicia", "efectivo"]
        && g.pagos is list && g.pagos.size() <= 200;
    }

    match /gastos/{id} {
      allow read, delete: if autorizado();
      allow create, update: if autorizado() && gastoValido(request.resource.data);
    }
  }
}
