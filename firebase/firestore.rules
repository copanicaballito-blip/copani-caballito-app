// Reglas de Firestore. Se publican a mano: Firebase > Firestore Database > Reglas > pegar > Publicar.
//
// IMPORTANTE: este repositorio es público. Acá van emails de ejemplo; en la consola de Firebase hay
// que reemplazarlos por los emails reales del equipo (en minúsculas). No subir los reales al repo.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function autorizado() {
      return request.auth != null
        && request.auth.token.email in [
          "persona1@ejemplo.com",
          "persona2@ejemplo.com",
          "persona3@ejemplo.com"
        ];
    }

    // formaPago y rubro son opcionales. El rubro solo se valida como texto corto (la lista de rubros
    // vive en la app), así agregar un rubro nuevo no obliga a republicar las reglas.
    function gastoValido(g) {
      return g.keys().hasOnly(["descripcion", "monto", "fechaPago", "estado", "pagos", "formaPago", "rubro"])
        && g.get("rubro", "") is string && g.get("rubro", "").size() <= 40
        && g.descripcion is string && g.descripcion.size() > 0 && g.descripcion.size() <= 120
        && g.monto is int && g.monto >= 0
        && g.fechaPago is string && g.fechaPago.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
        && g.estado in ["estimado", "a_pagar", "pagado"]
        && g.get("formaPago", "sin_definir") in ["sin_definir", "manual_mp", "debito_mp", "manual_galicia", "debito_galicia", "efectivo"]
        && g.pagos is list && g.pagos.size() <= 200;
    }

    function mesValido(m) {
      return m is string && m.matches("^[0-9]{4}-[0-9]{2}$");
    }

    // Gasto recurrente (una serie por gasto): primer/último mes, plantilla de cada período y datos de cada mes.
    // El detalle de `cambios` y `meses` lo controla la app; acá se valida la forma general.
    function recurrenteValido(r) {
      return r.keys().hasOnly(["desde", "hasta", "cambios", "meses"])
        && mesValido(r.desde)
        && mesValido(r.get("hasta", "2999-12"))
        && r.cambios is list && r.cambios.size() >= 1 && r.cambios.size() <= 200
        && r.meses is map && r.meses.keys().size() <= 600;
    }

    // Cierre de un mes terminado: copia congelada de sus gastos, de donde sale su Excel. Se crea una sola vez
    // (el documento se llama como el mes) y después no se puede modificar ni borrar desde la app.
    function cierreValido(c, mes) {
      return c.keys().hasOnly(["mes", "cerradoEn", "filas"])
        && c.mes == mes && mesValido(c.mes)
        && c.cerradoEn is string && c.cerradoEn.size() <= 40
        && c.filas is list && c.filas.size() <= 1500;
    }

    match /gastos/{id} {
      allow read, delete: if autorizado();
      allow create, update: if autorizado() && gastoValido(request.resource.data);
    }

    match /recurrentes/{id} {
      allow read, delete: if autorizado();
      allow create, update: if autorizado() && recurrenteValido(request.resource.data);
    }

    match /cierres/{mes} {
      allow read: if autorizado();
      allow create: if autorizado() && cierreValido(request.resource.data, mes);
      allow update, delete: if false;
    }
  }
}
