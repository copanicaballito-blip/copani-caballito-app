# Copiar este archivo como `.env` y completar los valores.
# `.env` esta en .gitignore: nunca se sube al repositorio.

# Proyecto de Supabase (Settings > API en el panel de Supabase)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# IMPORTANTE: las variables EXPO_PUBLIC_* quedan embebidas en la app.
# Nunca poner aqui la "service_role key" ni otros secretos de servidor.
